# docker compose up reads this file as .env
# Required: guards the browser gateway's WebSocket. Open http://127.0.0.1:8600/?token=<value>
PI_WEB_TOKEN=change-me
# Provider credentials for the model in docker/web/config/settings.json.
ANTHROPIC_API_KEY=
# For a custom provider declared in docker/web/config/models.json, e.g. a LiteLLM gateway.
LITELLM_API_KEY=
